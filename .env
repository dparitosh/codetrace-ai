# CodeTrace AI - Real-Life Data Configuration
# Step-by-step setup for testing with live GitHub repositories

# Application Settings
DEBUG=true
HOST=localhost
PORT=8009

# Frontend Configuration (for Vite)
VITE_HOST=localhost
VITE_PROTOCOL=http
VITE_BACKEND_PORT=8009
VITE_FRONTEND_PORT=3001
VITE_BACKEND_URL=http://localhost:8009

# Real-Life Data Configuration (No Fallbacks)
GITHUB_API_FALLBACK=false
USE_MOCK_DATA=false
FORCE_FRESH_DATA=true
ENABLE_CACHING=false
CACHE_TTL=0
DISABLE_ALL_FALLBACKS=true

# GitHub API Settings
GITHUB_TOKEN=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
GITHUB_API_TIMEOUT=180

# Analysis Limits
MAX_REPOSITORY_SIZE=500MB
MAX_FILES_PER_REPO=10000
ANALYSIS_TIMEOUT=600

# Database (Optional - for persistence)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=codetrace_ai
DB_USER=postgres
DB_PASSWORD=postgres

# Neo4j (Optional - for graph storage)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

# Security
JWT_SECRET=your-jwt-secret-here

# Feature Flags
ENABLE_AUTH=false
ENABLE_ANALYTICS=true
ENABLE_SECURITY_SCAN=true
ENABLE_DEPENDENCY_CHECK=true
ENABLE_CODE_QUALITY=true
ENABLE_PERFORMANCE_ANALYSIS=true
