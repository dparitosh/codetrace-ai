# Security
SECRET_KEY=e2e-testing-secret-key-do-not-use-in-production
JWT_SECRET=jwt-secret-for-testing-only-do-not-use-in-production

# Feature Flags for Testing
ENABLE_AUTH=false
ENABLE_ANALYTICS=true
ENABLE_CACHING=false

# Real Data Configuration
GITHUB_API_FALLBACK=false
USE_MOCK_DATA=false
FORCE_FRESH_DATA=true
GITHUB_API_TIMEOUT=180
CACHE_TTL=0
ENABLE_REAL_DATA_ONLY=true
DISABLE_ALL_FALLBACKS=true

# Analysis Configuration
MAX_REPOSITORY_SIZE=500MB
MAX_FILES_PER_REPO=10000
ANALYSIS_TIMEOUT=600

# Quality Assessment Configuration
ENABLE_SECURITY_SCAN=true
ENABLE_DEPENDENCY_CHECK=true
ENABLE_CODE_QUALITY=true
ENABLE_PERFORMANCE_ANALYSIS=true
