# CodeTrace AI local configuration. Copy to .env.local in the repository root.
# Process environment > .env.local > .env (legacy) > config/defaults.json.
# Restart backend and frontend after changes. Keep this file free of secrets.
HOST=127.0.0.1
BACKEND_PORT=8009
FRONTEND_PORT=3001
DEBUG=false

# JSON lists. CORS defaults to the configured frontend plus localhost aliases.
# CORS_ORIGINS=["http://127.0.0.1:3001"]
GITLAB_ALLOWED_HOSTS=["gitlab.com"]
GITLAB_CLONE_TIMEOUT_SECONDS=60

# Source limits apply to API requests; browser filters before reading files.
MAX_LOCAL_FILES=500
MAX_LOCAL_PAYLOAD_BYTES=10000000
MAX_SOURCE_FILE_BYTES=2000000
# Optional overrides REPLACE parser defaults; use JSON arrays.
# SOURCE_EXTENSIONS=[".py",".js",".jsx",".ts",".tsx"]
# SOURCE_EXCLUDES=[".git","node_modules",".venv","venv","__pycache__","dist","build","target","bin","obj",".idea",".pytest_cache"]
SECURITY_MAX_FINDINGS=200
GRAPH_PREVIEW_NODES=100
GRAPH_PREVIEW_EDGES=220
MAX_TRACE_MANIFEST_BYTES=1000000

# Relative paths resolve from the repository root.
UPLOAD_DIR=data/uploads
TEMP_DIR=temp
LOG_DIR=logs

# Review/session limits. Memory requires one worker. SQLite supports workers on
# one host with a shared private local-disk path and retains reviews until expiry.
SESSION_STORE=memory
SESSION_DB_PATH=data/reviews.sqlite3
REQUEST_TIMEOUT_SECONDS=120
SESSION_IDLE_SECONDS=1800
SESSION_MAX_SECONDS=28800
MAX_SESSIONS=32
MAX_REVIEWS_PER_SESSION=10
MAX_REVIEW_STORAGE_BYTES=50000000
MAX_CONCURRENT_ANALYSES=2

MAX_GRAPH_NODES=50000
MAX_GRAPH_EDGES=100000
CONTROL_REQUEST_TIMEOUT_SECONDS=15
REVIEW_PREVIEW_ITEMS=100
STARTUP_TIMEOUT_SECONDS=30

# Central administrator catalog. Browser users select IDs; no endpoint entry in UI.
# Default local source. Absolute Windows paths may use forward slashes.
# Relative paths resolve from this application checkout, independently of cwd.
SOURCE_FOLDER=.
# Optional multi-source catalog overrides SOURCE_FOLDER when explicitly set.
# MANAGED_REPOSITORIES=[{"id":"workspace","label":"My project","kind":"local","path":"D:/Projects/MyApp"}]
# Git example: {"id":"service","label":"Service","kind":"git","url":"https://github.com/organization/service.git","ref":"main"}
# Private Git: add token_env to name a server-side access-token variable.
# Host credential helpers, filters, hooks and global Git configuration are isolated.
# SBOM: add sbom_path for CycloneDX 1.4–1.6 / SPDX 2.2–2.3 JSON, or sbom_lockfiles
# for repository-relative npm v2/v3 lockfiles (default root and frontend lockfiles).
# Add manifest_path to a repository for explicit code/lifecycle links.
OSLC_PROVIDERS=[]
# Provider example: {"id":"rm","label":"Requirements","domain":"RM","endpoint":"https://alm.example/oslc/query","allowed_base_url":"https://alm.example/oslc/","token_env":"ALM_TOKEN","repository_ids":["workspace"]}
# TRS uses domain TRS and a tracked-resource-set endpoint. Offline RDF: file_path.
CI_PROVIDERS=[]
# CI example: {"id":"builds","label":"GitHub Actions","platform":"github","repository_id":"workspace","endpoint":"https://api.github.com/repos/organization/service/actions/runs","token_env":"GITHUB_TOKEN"}
OSLC_TIMEOUT_SECONDS=20
OSLC_MAX_PAGES=10
OSLC_MAX_RESOURCES=500
OSLC_MAX_RESPONSE_BYTES=2000000
TRS_INCREMENTAL=true
TRS_CACHE_PATH=data/trs.sqlite3
TRS_CACHE_EVENTS=1000
TRS_CACHE_MAX_BYTES=20000000
CI_MAX_PAGES=5
CI_MAX_RUNS=100
SBOM_MAX_BYTES=10000000
SBOM_MAX_COMPONENTS=2000
# Advisory queries are disabled until the administrator selects an endpoint.
# Customer service must implement the documented OSV-compatible batch contract.
VULNERABILITY_PROVIDER=disabled
VULNERABILITY_API_URL=
# Testing only: VULNERABILITY_API_URL=https://api.osv.dev/v1/querybatch
VULNERABILITY_REQUIRE_HTTPS=false
VULNERABILITY_TOKEN_ENV=CODETRACE_VULNERABILITY_TOKEN
VULNERABILITY_KEY_HEADER=Authorization
VULNERABILITY_TIMEOUT_SECONDS=20
VULNERABILITY_MAX_RESPONSE_BYTES=2000000
VULNERABILITY_BATCH_SIZE=100
WORKSPACE_RENDER_NODES=400
WORKSPACE_RENDER_EDGES=1000

# Local companion; no cloud request or model download is performed automatically.
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=qwen2.5-coder:7b
AI_TIMEOUT_SECONDS=45
AI_CONTEXT_NODES=35
# AI_TOKEN_ENV=CODETRACE_AI_TOKEN
# Keep credentials such as ALM_TOKEN and GITHUB_TOKEN only in .env.local/process env.
# Optional legacy PostgreSQL bootstrap (the local-first API does not use it).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=codetrace_ai
POSTGRES_USER=codetrace
POSTGRES_PASSWORD=
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
AI_CONTEXT_RELATIONS=80
AI_MAX_OUTPUT_TOKENS=700
AI_MAX_RESPONSE_BYTES=2000000
AI_MAX_ANSWER_CHARACTERS=10000

# Optional OSLC publication / collaboration server profile.
# No remote link write is allowed unless the individual provider has allow_writes=true.
# Polarion/Codebeamer profiles may set product, auth_type=basic, username_env and password_env.
# Token values belong only in private .env.local/process variables, never this example.
OSLC_DB_PATH=data/oslc.sqlite3
OSLC_SERVER_ALLOW_WRITES=false
OSLC_SERVER_TOKEN_ENV=CODETRACE_OSLC_TOKEN
OSLC_SERVER_WRITE_TOKEN_ENV=CODETRACE_OSLC_WRITE_TOKEN
# OSLC_PUBLIC_BASE_URL is derived from HOST/BACKEND_PORT unless explicitly configured.

# Session Ollama registration: Connections > Connect Ollama REST.
# API keys are entered in the UI; no real key belongs in this example.
# Additional URLs must be registered centrally (exact REST bases, JSON array).
AI_ALLOWED_BASE_URLS=[]
# HTTP is allowed by default for configured AI endpoints. True enforces HTTPS,
# including loopback; endpoint allowlisting and credential validation still apply.
AI_REQUIRE_HTTPS=false
# Disable discovery for gateways exposing chat/embed but no GET /api/tags.
AI_DISCOVERY_ENABLED=true
AI_KEY_HEADER=Authorization
AI_EMBEDDING_MODEL=nomic-embed-text
AI_EMBEDDING_MAX_NODES=300
AI_EMBEDDING_BATCH_SIZE=24
AI_AGENT_MAX_STEPS=5
AI_AGENT_DEADLINE_SECONDS=120
AI_CONTEXT_MAX_BYTES=120000
# Durable local change workbench; separate from expiring review sessions.
CHANGE_DB_PATH=data/changes.sqlite3
CHANGE_MAX_CASES=128
CHANGE_MAX_BYTES=50000000
