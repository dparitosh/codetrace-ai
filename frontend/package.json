{
  "name": "codetrace-ai-frontend",
  "version": "1.0.0",
  "description": "CodeTrace AI Frontend - local-first source-code analysis dashboard",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest --maxWorkers=1",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@siemens/ix": "^5.3.0",
    "@siemens/ix-icons": "^3.7.0",
    "@siemens/ix-react": "^5.3.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.12.0",
    "@types/d3-drag": "^3.0.0",
    "@types/d3-force": "^3.0.0",
    "@types/d3-selection": "^3.0.0",
    "@types/d3-zoom": "^3.0.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^8.2.2",
    "@typescript-eslint/parser": "^8.2.2",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.4",
    "@vitest/ui": "^5.0.4",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.53.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "postcss": "^8.4.32",
    "prettier": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.5.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.2.2",
    "vite": "^7.0.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "codetrace-ai",
    "local-source-analysis",
    "code-quality",
    "dependency-visualization",
    "react",
    "typescript",
    "vite"
  ],
  "author": "CodeTrace AI Team",
  "license": "MIT",
  "homepage": "https://codetrace.ai",
  "packageManager": "npm@10.9.9"
}
