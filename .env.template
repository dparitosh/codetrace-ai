# CodeTrace AI - Environment Configuration
# NO HARDCODED PORTS OR URLS - All configurable via environment variables

# ================================
# SERVER CONFIGURATION
# ================================
HOST=localhost
BACKEND_PORT=8009
FRONTEND_PORT=3001

# ================================
# SERVICE URLS (AUTO-GENERATED)
# ================================
BACKEND_URL=http://${HOST}:${BACKEND_PORT}
FRONTEND_URL=http://${HOST}:${FRONTEND_PORT}
API_DOCS_URL=${BACKEND_URL}/docs
HEALTH_URL=${BACKEND_URL}/health

# ================================
# CORS ORIGINS (DYNAMIC)
# ================================
CORS_ORIGINS=["http://${HOST}:${FRONTEND_PORT}","http://127.0.0.1:${FRONTEND_PORT}","http://${HOST}:3000","http://${HOST}:5173"]

# ================================
# DATABASE CONFIGURATION
# ================================
DB_HOST=localhost
DB_PORT=5433
DB_NAME=codeace_ai
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ================================
# REDIS CONFIGURATION
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# ================================
# NEO4J CONFIGURATION
# ================================
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j
NEO4J_URI=bolt://${NEO4J_HOST}:${NEO4J_PORT}

# ================================
# GITHUB CONFIGURATION
# ================================
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_INSTALLATION_ID=

# ================================
# SECURITY CONFIGURATION
# ================================
JWT_SECRET=jwt-secret-for-testing-only
JWT_ALGORITHM=HS256
JWT_EXPIRATION=604800

# ================================
# FEATURE FLAGS
# ================================
DEBUG=false
ENABLE_AUTH=false
ENABLE_ANALYTICS=true
ENABLE_CACHING=false
ENABLE_WEBHOOKS=true
ENABLE_MONITORING=false

# ================================
# ANALYSIS CONFIGURATION
# ================================
MAX_REPOSITORY_SIZE=500MB
MAX_FILES_PER_REPO=10000
ANALYSIS_TIMEOUT=600
ENABLE_REAL_DATA_ONLY=true
DISABLE_ALL_FALLBACKS=true

# ================================
# RATE LIMITING
# ================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ================================
# LOGGING CONFIGURATION
# ================================
LOG_LEVEL=INFO
LOG_DIR=./logs

# ================================
# CACHE CONFIGURATION
# ================================
CACHE_TTL=0
CACHE_MAX_SIZE=1000

# ================================
# MONITORING
# ================================
SENTRY_DSN=
DATADOG_API_KEY=
PROMETHEUS_ENABLED=false

# ================================
# EXTERNAL SERVICES
# ================================
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
EMAIL_SERVICE_API_KEY=
